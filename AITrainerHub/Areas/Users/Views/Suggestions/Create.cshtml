@model SuggestPlatformViewModel
@{
    ViewData["Title"] = "Suggest a Platform";
    var returnUrl = Context.Request.Path.ToString();
}

<div class="users-page">
    <div class="admin-page-header">
        <div>
            <p class="users-hero__eyebrow">Community contribution</p>
            <h1 class="admin-page-title">Suggest a platform</h1>
            <p class="admin-page-subtitle">
                Tell us about an AI training platform that deserves a place in the directory.
                Every suggestion is reviewed by an administrator before it is published.
            </p>
        </div>

        <div class="admin-page-actions">
            <a asp-area="Users" asp-controller="Platforms" asp-action="Index" class="admin-btn admin-btn--ghost">Back to platforms</a>
        </div>
    </div>

    <div class="users-form-layout">
        <form asp-area="Users"
              asp-controller="Suggestions"
              asp-action="Create"
              method="post"
              class="admin-form admin-card users-form-card"
              data-submit-once>
            <div class="admin-card__header">
                <div>
                    <h2 class="admin-card__title">Platform details</h2>
                    <p class="admin-card__subtitle">Share as much detail as you can. Clear suggestions are reviewed faster.</p>
                </div>
                <span class="admin-badge admin-badge--amber">Pending moderation</span>
            </div>

            <div class="admin-card__body">
                <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--error" role="alert"></div>

                <div class="admin-grid admin-grid--2">
                    <div class="admin-field">
                        <label asp-for="Form.PlatformName" class="admin-label">Platform name</label>
                        <input asp-for="Form.PlatformName" class="admin-input" maxlength="150" placeholder="e.g. Example AI Tasks" />
                        <span asp-validation-for="Form.PlatformName" class="admin-error"></span>
                    </div>

                    <div class="admin-field">
                        <label asp-for="Form.Url" class="admin-label">Platform URL</label>
                        <input asp-for="Form.Url" type="url" dir="ltr" class="admin-input" maxlength="300" placeholder="https://example.com" />
                        <span asp-validation-for="Form.Url" class="admin-error"></span>
                    </div>

                    <div class="admin-field">
                        <label asp-for="Form.EmailOfUser" class="admin-label">Your email (optional)</label>
                        <input asp-for="Form.EmailOfUser" type="email" dir="ltr" class="admin-input" maxlength="150" placeholder="you@example.com" />
                        <span class="admin-help">Only used if we need to ask a follow-up question.</span>
                        <span asp-validation-for="Form.EmailOfUser" class="admin-error"></span>
                    </div>

                    <div class="admin-field">
                        <label asp-for="Form.CategoryId" class="admin-label">Category (optional)</label>
                        <select asp-for="Form.CategoryId" class="admin-select">
                            <option value="">Choose a category</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (Model.Form.CategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Form.CategoryId" class="admin-error"></span>
                    </div>
                </div>

                <div class="admin-field">
                    <label asp-for="Form.Description" class="admin-label">Why should this platform be listed?</label>
                    <textarea asp-for="Form.Description" class="admin-textarea" maxlength="1000"
                              placeholder="Describe the tasks, payout methods, supported countries and your experience."></textarea>
                    <span asp-validation-for="Form.Description" class="admin-error"></span>
                </div>
            </div>

            <div class="admin-card__footer">
                <div class="admin-actions">
                    <button type="submit" class="admin-btn admin-btn--primary">Submit suggestion</button>
                    <a asp-area="Users" asp-controller="Platforms" asp-action="Index" class="admin-btn admin-btn--ghost">Cancel</a>
                </div>
            </div>
        </form>

        <aside class="users-form-aside">
            <div class="admin-alert admin-alert--info">
                <strong>What happens next?</strong>
                Your suggestion enters the moderation queue. If it is approved, the platform is added to the
                public directory by an administrator. You will not be notified automatically.
            </div>

            <div class="admin-card">
                <div class="admin-card__header">
                    <div>
                        <h2 class="admin-card__title">Good suggestions include</h2>
                    </div>
                </div>
                <div class="admin-card__body">
                    <ul class="users-tip-list">
                        <li>The official platform URL.</li>
                        <li>The type of AI training tasks available.</li>
                        <li>Payment methods and payout timing.</li>
                        <li>Countries that are accepted.</li>
                        <li>Your own experience, if you have worked there.</li>
                    </ul>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="admin-card">
                    <div class="admin-card__body">
                        <p class="users-muted users-aside-copy">You need an active account to submit a suggestion.</p>
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@returnUrl" class="admin-btn admin-btn--primary admin-btn--sm users-aside-cta">Sign in</a>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>
