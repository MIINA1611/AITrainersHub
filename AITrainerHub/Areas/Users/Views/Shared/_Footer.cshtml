@using Microsoft.AspNetCore.Identity
@using AITrainersHub.Domain.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isLeader = User.IsInRole("Leader");
    var isAdmin = User.IsInRole("Admin");
    var currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.DisplayName ?? User.Identity?.Name ?? string.Empty;
}
<footer class="border-t border-white/5 py-8 text-sm text-gray-500">
    <div class="max-w-7xl mx-auto px-4 text-center">
        <p>&copy; 2026 AI Trainers Hub &mdash; Directory for AI training jobs.</p>
        <div class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs">
            <a asp-area="Users" asp-controller="Platforms" asp-action="Index" class="hover:text-white transition-colors">Platforms</a>
            <a asp-area="Users" asp-controller="Opportunities" asp-action="Index" class="hover:text-white transition-colors">Opportunities</a>
            <a asp-area="Users" asp-controller="Suggestions" asp-action="Create" class="hover:text-white transition-colors">Suggest a platform</a>

            @if (isSignedIn)
            {
                @if (isLeader)
                {
                    <a asp-area="Leader" asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">Leader dashboard</a>
                }
                @if (isAdmin)
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:text-white transition-colors">Admin dashboard</a>
                }
                @if (!string.IsNullOrWhiteSpace(displayName))
                {
                    <span class="text-gray-600">@displayName</span>
                }
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Users" })" method="post" class="inline">
                    <button type="submit" class="hover:text-white transition-colors">Sign out</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="hover:text-white transition-colors">Sign in</a>
            }
        </div>
    </div>
</footer>
