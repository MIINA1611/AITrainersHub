@model PlatformDirectorySectionViewModel
@{
    var directory = Model.Directory;

    var routeValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(directory.Search))
    {
        routeValues["search"] = directory.Search;
    }
    if (directory.Status.HasValue)
    {
        routeValues["status"] = directory.Status.Value.ToString();
    }
    if (directory.CategoryId.HasValue)
    {
        routeValues["category"] = directory.CategoryId.Value.ToString();
    }
    if (directory.CountryId.HasValue)
    {
        routeValues["country"] = directory.CountryId.Value.ToString();
    }
    if (directory.PaymentMethodId.HasValue)
    {
        routeValues["payment"] = directory.PaymentMethodId.Value.ToString();
    }

    var pagination = new PaginationViewModel
    {
        Area = Model.Area,
        Controller = Model.Controller,
        Action = Model.Action,
        Fragment = Model.Fragment,
        Page = directory.Page,
        TotalPages = directory.TotalPages,
        TotalCount = directory.TotalCount,
        PageSize = directory.PageSize,
        RouteValues = routeValues
    };

    var baseUrl = Url.Action(Model.Action, Model.Controller, new { area = Model.Area }) ?? "#";
    var fragment = string.IsNullOrWhiteSpace(Model.Fragment) ? string.Empty : $"#{Model.Fragment}";
    var formAction = baseUrl + fragment;
    var clearUrl = baseUrl + fragment;
}

<div class="users-directory-layout">
    <div class="users-directory-main">
        <form action="@formAction" method="get" class="users-filter-card" role="search">
            <div class="users-filter-grid">
                <div class="admin-field users-filter-search">
                    <label for="platformSearch" class="admin-label">Search</label>
                    <input id="platformSearch" name="search" type="search" value="@directory.Search" class="admin-input" placeholder="Platform name or slug" />
                </div>

                <div class="admin-field">
                    <label for="platformCategory" class="admin-label">Category</label>
                    <select id="platformCategory" name="category" class="admin-select" data-auto-submit>
                        <option value="">All categories</option>
                        @foreach (var category in directory.Categories)
                        {
                            if (directory.CategoryId == category.Id)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="admin-field">
                    <label for="platformStatus" class="admin-label">Status</label>
                    <select id="platformStatus" name="status" class="admin-select" data-auto-submit>
                        <option value="">All statuses</option>
                        @foreach (var status in new[] { PlatformStatus.Open, PlatformStatus.Soon, PlatformStatus.Closed })
                        {
                            if (directory.Status == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="admin-field">
                    <label for="platformCountry" class="admin-label">Country</label>
                    <select id="platformCountry" name="country" class="admin-select" data-auto-submit>
                        <option value="">All countries</option>
                        @foreach (var country in directory.Countries)
                        {
                            var countryName = string.IsNullOrWhiteSpace(country.NameEn) ? country.NameAr : country.NameEn;
                            if (directory.CountryId == country.Id)
                            {
                                <option value="@country.Id" selected>@countryName</option>
                            }
                            else
                            {
                                <option value="@country.Id">@countryName</option>
                            }
                        }
                    </select>
                </div>

                <div class="admin-field">
                    <label for="platformPayment" class="admin-label">Payment method</label>
                    <select id="platformPayment" name="payment" class="admin-select" data-auto-submit>
                        <option value="">All payment methods</option>
                        @foreach (var paymentMethod in directory.PaymentMethods)
                        {
                            if (directory.PaymentMethodId == paymentMethod.Id)
                            {
                                <option value="@paymentMethod.Id" selected>@paymentMethod.Name</option>
                            }
                            else
                            {
                                <option value="@paymentMethod.Id">@paymentMethod.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="users-filter-actions">
                    <button type="submit" class="admin-btn admin-btn--primary">Apply filters</button>
                    @if (directory.HasFilters)
                    {
                        <a href="@clearUrl" class="admin-btn admin-btn--ghost">Clear</a>
                    }
                </div>
            </div>
        </form>

        <div class="users-results-head">
            <span>@directory.TotalCount platform@(directory.TotalCount == 1 ? "" : "s") found</span>
            @if (directory.HasFilters)
            {
                <a href="@clearUrl" class="users-section__link">Clear filters</a>
            }
        </div>

        @if (directory.Platforms.Count == 0)
        {
            <div class="users-empty">
                <p>No platforms match these filters.</p>
                <a href="@clearUrl" class="admin-btn admin-btn--ghost admin-btn--sm">Reset filters</a>
            </div>
        }
        else
        {
            <div class="users-card-grid">
                @foreach (var platform in directory.Platforms)
                {
                    <partial name="_PlatformCard" model="platform" />
                }
            </div>
        }

        <partial name="_Pagination" model="pagination" />
    </div>

    <aside class="users-directory-aside">
        <vc:advertisement-slot position="Sidebar"></vc:advertisement-slot>

        <div class="admin-card">
            <div class="admin-card__header">
                <div>
                    <h2 class="admin-card__title">Directory tips</h2>
                    <p class="admin-card__subtitle">Get more from every listing.</p>
                </div>
            </div>
            <div class="admin-card__body">
                <ul class="users-tip-list">
                    <li>Read reviews before applying to a platform.</li>
                    <li>Check the country support notes for your region.</li>
                    <li>Confirm payout methods before you start working.</li>
                    <li>Share your own review after you finish a task.</li>
                </ul>
                <a asp-area="Users" asp-controller="Opportunities" asp-action="Index" class="admin-btn admin-btn--ghost admin-btn--sm users-aside-cta">Browse opportunities</a>
            </div>
        </div>
    </aside>
</div>
