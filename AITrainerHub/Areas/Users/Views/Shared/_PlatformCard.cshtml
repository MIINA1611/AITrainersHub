@model PlatformListResponse
@{
    var description = DisplayHelpers.PreferredDescription(Model.DescriptionAr, Model.DescriptionEn);
    var platformKey = string.IsNullOrWhiteSpace(Model.Slug) ? Model.Id.ToString() : Model.Slug;
    var detailsUrl = Url.Action("Details", "Platforms", new { area = "Users", id = platformKey }) ?? "#";
    var filledStars = (int)Math.Round(Model.AverageRating, MidpointRounding.AwayFromZero);
}
<article class="users-platform-card">
    <div class="users-platform-card__head">
        <span class="users-platform-card__avatar">@DisplayHelpers.Initials(Model.Name)</span>
        <div class="users-platform-card__identity">
            <h3 class="users-platform-card__title">
                <a href="@detailsUrl">@Model.Name</a>
            </h3>
            <p class="users-platform-card__slug">@("@" + Model.Slug)</p>
        </div>
        <span class="admin-badge @DisplayHelpers.PlatformStatusCss(Model.Status)">@Model.Status</span>
    </div>

    <p class="users-platform-card__copy">
        @(string.IsNullOrWhiteSpace(description)
            ? "Platform details are being prepared."
            : DisplayHelpers.Excerpt(description, 145))
    </p>

    @if (Model.Categories.Count > 0)
    {
        <div class="users-chip-list">
            @foreach (var category in Model.Categories.Take(4))
            {
                <span class="users-chip">@category.Name</span>
            }
        </div>
    }

    <div class="users-platform-card__meta">
        <span>@Model.Countries.Count countr@(Model.Countries.Count == 1 ? "y" : "ies")</span>
        <span class="users-meta-dot" aria-hidden="true"></span>
        <span>@Model.PaymentMethods.Count payout method@(Model.PaymentMethods.Count == 1 ? "" : "s")</span>
        <span class="users-meta-dot" aria-hidden="true"></span>
        <span>@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s")</span>
    </div>

    <div class="users-platform-card__footer">
        <div class="users-rating" title="Average rating">
            <span class="users-stars" aria-hidden="true">
                @for (var star = 1; star <= 5; star++)
                {
                    @(star <= filledStars ? "★" : "☆")
                }
            </span>
            <span class="users-rating__value">@DisplayHelpers.Rating(Model.AverageRating)</span>
        </div>

        <a href="@detailsUrl" class="admin-btn admin-btn--primary admin-btn--sm">View details</a>
    </div>
</article>
