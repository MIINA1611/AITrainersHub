@model PlatformListResponse
@{
    var description = DisplayHelpers.PreferredDescription(Model.DescriptionAr, Model.DescriptionEn);
    var platformKey = string.IsNullOrWhiteSpace(Model.Slug) ? Model.Id.ToString() : Model.Slug;
    var detailsUrl = Url.Action("Details", "Platforms", new { area = "Users", id = platformKey }) ?? "#";
    var applyUrl = string.IsNullOrWhiteSpace(Model.ReferralLink) ? Model.WebsiteUrl : Model.ReferralLink;
    var filledStars = (int)Math.Round(Model.AverageRating, MidpointRounding.AwayFromZero);
    var categories = Model.Categories.Take(2).ToList();
    var payments = Model.PaymentMethods.Take(2).ToList();
}
<article class="users-platform-card users-platform-card--landing">
    <div class="users-platform-card__top">
        <span class="admin-badge @DisplayHelpers.PlatformStatusCss(Model.Status)">@Model.Status</span>
        <span class="users-platform-card__avatar" aria-hidden="true">@DisplayHelpers.Initials(Model.Name)</span>
    </div>

    <h3 class="users-platform-card__title">
        <a href="@detailsUrl">@Model.Name</a>
    </h3>

    <p class="users-platform-card__copy">
        @(string.IsNullOrWhiteSpace(description)
            ? "Platform details are being prepared."
            : DisplayHelpers.Excerpt(description, 150))
    </p>

    <div class="users-platform-card__tags">
        @foreach (var category in categories)
        {
            <span class="users-chip">@category.Name</span>
        }
        @foreach (var payment in payments)
        {
            <span class="users-chip users-chip--accent">@payment.Name</span>
        }
    </div>

    <div class="users-platform-card__footer">
        <div class="users-platform-card__actions">
            @if (!string.IsNullOrWhiteSpace(applyUrl))
            {
                <a href="@applyUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="users-apply-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h6v6"></path>
                        <path d="M10 14 21 3"></path>
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    </svg>
                    Apply
                </a>
            }
            <a href="@detailsUrl" class="users-details-link">Details</a>
        </div>

        <div class="users-rating" title="Average rating">
            <span class="users-rating__count">(@Model.ReviewCount)</span>
            <span class="users-rating__value">@DisplayHelpers.Rating(Model.AverageRating)</span>
            <span class="users-stars" aria-label="@DisplayHelpers.Rating(Model.AverageRating) out of 5 stars">
                @for (var star = 1; star <= 5; star++)
                {
                    @(star <= filledStars ? "\u2605" : "\u2606")
                }
            </span>
        </div>
    </div>
</article>
