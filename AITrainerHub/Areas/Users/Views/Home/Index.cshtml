@model PublicHomeViewModel
@{
    ViewData["Title"] = "Discover AI Training Platforms";
}

<div class="users-page">
    <section class="users-hero">
        <div class="users-hero__grid">
            <div class="users-hero__content">
                <p class="users-hero__eyebrow">Verified AI training work</p>
                <h1 class="users-hero__title">Find trusted AI training platforms in one place</h1>
                <p class="users-hero__lead">
                    Compare payout methods, supported countries and real community reviews before you apply.
                    Every listing is reviewed by our team.
                </p>
                <p class="users-hero__arabic" dir="rtl" lang="ar">
                    اكتشف منصات تدريب الذكاء الاصطناعي الموثوقة، وقارن طرق الدفع والدول المدعومة قبل التقديم.
                </p>

                <form asp-area="Users" asp-controller="Platforms" asp-action="Index" method="get" class="users-hero__search" role="search">
                    <label for="homeSearch" class="sr-only">Search platforms</label>
                    <input id="homeSearch" name="search" type="search" class="admin-input" placeholder="Search by platform name or slug" />
                    <button type="submit" class="admin-btn admin-btn--primary">Search</button>
                </form>

                <div class="users-hero__actions">
                    <a asp-area="Users" asp-controller="Platforms" asp-action="Index" class="admin-btn admin-btn--primary">Browse platforms</a>
                    <a asp-area="Users" asp-controller="Opportunities" asp-action="Index" class="admin-btn admin-btn--ghost">See opportunities</a>
                </div>

                <div class="users-stat-row">
                    <div class="users-stat">
                        <span class="users-stat__value">@Model.TotalPlatforms</span>
                        <span class="users-stat__label">Platforms</span>
                    </div>
                    <div class="users-stat">
                        <span class="users-stat__value">@Model.TotalOpportunities</span>
                        <span class="users-stat__label">Live opportunities</span>
                    </div>
                    <div class="users-stat">
                        <span class="users-stat__value">@Model.Categories.Count</span>
                        <span class="users-stat__label">Categories</span>
                    </div>
                </div>
            </div>

            <vc:advertisement-slot position="Hero"></vc:advertisement-slot>
        </div>
    </section>

    @if (Model.Categories.Count > 0)
    {
        <section class="users-section">
            <div class="users-section__header">
                <div>
                    <h2 class="users-section__title">Browse by category</h2>
                    <p class="users-section__lead">Pick a skill area and jump straight to matching platforms.</p>
                </div>
            </div>

            <div class="users-chip-list users-chip-list--large">
                @foreach (var category in Model.Categories)
                {
                    var count = Model.CategoryCounts.TryGetValue(category.Id, out var categoryCount) ? categoryCount : 0;
                    <a asp-area="Users"
                       asp-controller="Platforms"
                       asp-action="Index"
                       asp-route-category="@category.Id"
                       class="users-category-chip">
                        <span>@category.Name</span>
                        <span class="users-category-chip__count">@count</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="users-section">
        <div class="users-section__header">
            <div>
                <h2 class="users-section__title">Featured platforms</h2>
                <p class="users-section__lead">Top-rated partners with clear payouts and active task queues.</p>
            </div>
            <a asp-area="Users" asp-controller="Platforms" asp-action="Index" class="users-section__link">View all platforms</a>
        </div>

        @if (Model.FeaturedPlatforms.Count == 0)
        {
            <div class="users-empty">
                <p>No platforms are available yet. Check back soon or suggest a platform for the community.</p>
                <a asp-area="Users" asp-controller="Suggestions" asp-action="Create" class="admin-btn admin-btn--primary admin-btn--sm">Suggest a platform</a>
            </div>
        }
        else
        {
            <div class="users-card-grid">
                @for (var index = 0; index < Model.FeaturedPlatforms.Count; index++)
                {
                    if (index == 3)
                    {
                        <vc:advertisement-slot position="BetweenCards"></vc:advertisement-slot>
                    }

                    <partial name="_PlatformCard" model="Model.FeaturedPlatforms[index]" />
                }
            </div>
        }
    </section>

    <section class="users-section">
        <div class="users-section__header">
            <div>
                <h2 class="users-section__title">Latest opportunities</h2>
                <p class="users-section__lead">Fresh work shared by verified leaders and approved by our team.</p>
            </div>
            <a asp-area="Users" asp-controller="Opportunities" asp-action="Index" class="users-section__link">View the board</a>
        </div>

        @if (Model.LatestOpportunities.Count == 0)
        {
            <div class="users-empty">
                <p>No live opportunities right now. New opportunities appear here after administrator approval.</p>
            </div>
        }
        else
        {
            <div class="users-card-grid">
                @foreach (var opportunity in Model.LatestOpportunities)
                {
                    <partial name="_OpportunityCard" model="opportunity" />
                }
            </div>
        }
    </section>

    <section class="users-cta">
        <div class="users-cta__content">
            <p class="users-hero__eyebrow">Help the community grow</p>
            <h2 class="users-section__title">Know a platform that should be listed?</h2>
            <p class="users-section__lead">
                Suggest it to our team. Every submission is reviewed before it is published, and approved
                contributions make the directory better for everyone.
            </p>
            <a asp-area="Users" asp-controller="Suggestions" asp-action="Create" class="admin-btn admin-btn--primary">Suggest a platform</a>
        </div>

        <vc:advertisement-slot position="Sidebar"></vc:advertisement-slot>
    </section>
</div>
