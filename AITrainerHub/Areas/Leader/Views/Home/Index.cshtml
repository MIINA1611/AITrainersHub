@{
    ViewData["Title"] = "Leader Dashboard";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div>
            <p class="text-xs tracking-widest uppercase text-purple-400 font-semibold">Leader area</p>
            <h1 class="text-3xl font-bold mt-1">Leader Dashboard</h1>
        </div>
        <span class="inline-flex items-center rounded-full border border-amber-500/20 bg-amber-500/10 text-amber-400 px-3 py-1 text-xs font-semibold">Coming soon</span>
    </div>

    <div class="rounded-2xl border border-white/10 bg-black/40 p-6 sm:p-8">
        <p class="text-gray-400 leading-relaxed">
            Post work opportunities for the community. They go live after admin approval.
        </p>

        <div class="mt-6 rounded-xl border border-dashed border-white/15 bg-white/[0.06] p-5">
            <div class="flex items-start gap-3">
                <div class="p-2 inline-flex rounded-lg bg-purple-500/10 text-purple-400 border border-purple-500/20">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                        <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="font-semibold">Opportunity posting is on the way</h2>
                    <p class="text-sm text-gray-400 mt-1">
                        The leader queue and posting workflow will be enabled after the CQRS backend is implemented. This shell is ready for that next step.
                    </p>
                </div>
            </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
            <a asp-area="Users" asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 h-10 px-5 rounded-full bg-white text-black font-semibold text-sm hover:bg-gray-100 transition-colors">
                Back to directory
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
            <button type="button" data-placeholder="Leader tools are coming soon." class="inline-flex items-center h-10 px-5 rounded-full border border-white/10 text-sm text-white hover:bg-white/5 transition-colors">
                Explore leader tools
            </button>
        </div>
    </div>
</div>
