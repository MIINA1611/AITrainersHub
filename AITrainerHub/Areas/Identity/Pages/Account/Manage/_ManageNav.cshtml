@using AITrainersHub.Domain.Models
@inject SignInManager<ApplicationUser> SignInManager
<nav class="flex flex-col gap-1 text-sm">
    <span class="px-3 py-2 text-xs font-semibold tracking-widest text-gray-500 uppercase">Account</span>

    @if (SignInManager.IsSignedIn(User))
    {
        <span class="px-3 text-xs text-gray-500 truncate mb-2">@User.Identity?.Name</span>
    }

    <a asp-page="./ChangePassword" class="px-3 py-2 rounded-lg bg-white/10 text-white font-medium">Password</a>
    <a asp-area="Users" asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-colors">Back to directory</a>
</nav>
