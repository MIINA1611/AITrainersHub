@page
@model RegisterModel

@{
    ViewData["Title"] = "Create account";
    ViewData["AuthOverlay"] = "Join a community that helps AI trainers find trusted work.";
}

<div class="space-y-6">
    <div>
        <h1 class="auth-h1">Create your account</h1>
        <p class="auth-sub">Join AITrainersHub to review platforms, share guides and suggest new opportunities.</p>
    </div>

    @if (TempData["Error"] is string pageError && !string.IsNullOrWhiteSpace(pageError))
    {
        <div class="auth-alert" role="alert">@pageError</div>
    }

    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

    <form id="register" method="post" class="space-y-4">
        <div>
            <label asp-for="Input.DisplayName" class="auth-label">Display name</label>
            <input asp-for="Input.DisplayName" class="auth-input" autocomplete="name" aria-required="true" placeholder="Your name" />
            <span asp-validation-for="Input.DisplayName" class="auth-error"></span>
        </div>

        <div>
            <label asp-for="Input.Email" class="auth-label">Email</label>
            <input asp-for="Input.Email" class="auth-input" autocomplete="username" aria-required="true" placeholder="m@example.com" />
            <span asp-validation-for="Input.Email" class="auth-error"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="auth-label">Password</label>
            <div class="relative">
                <input asp-for="Input.Password" class="auth-input pr-10" autocomplete="new-password" aria-required="true" placeholder="At least 8 characters" />
                <button type="button"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition-colors"
                        data-password-toggle="Input_Password"
                        aria-label="Show password">
                    <svg data-eye-open xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg data-eye-off xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 hidden" aria-hidden="true">
                        <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
                        <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
                        <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
                        <path d="m2 2 20 20"></path>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="auth-error"></span>
            <p class="auth-hint">Use 8+ characters with upper and lower case letters, a number and a symbol.</p>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="auth-label">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" aria-required="true" placeholder="Repeat your password" />
            <span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
        </div>

        <div class="auth-check">
            <input asp-for="Input.AcceptTerms" />
            <label asp-for="Input.AcceptTerms">@Html.DisplayNameFor(model => model.Input.AcceptTerms)</label>
        </div>
        <span asp-validation-for="Input.AcceptTerms" class="auth-error"></span>

        <button id="register-submit" type="submit" class="auth-btn">Create account</button>
    </form>

    <p class="text-center text-sm text-gray-400">
        Already have an account?
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
