@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    ViewData["AuthOverlay"] = "Thanks for stopping by. See you soon.";
}

<div class="space-y-6 text-center">
    <div>
        <h1 class="auth-h1">Log out</h1>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <p class="auth-sub">Are you sure you want to sign out?</p>
        }
        else
        {
            <p class="auth-sub">You have successfully logged out of the application.</p>
        }
    </div>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "Users" })" method="post">
            <button type="submit" class="auth-btn">Click here to Logout</button>
        </form>
    }
    else
    {
        <a asp-area="Users" asp-controller="Home" asp-action="Index" class="auth-btn">Back to home</a>
    }
</div>
