@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    ViewData["AuthOverlay"] = "We'll email you a secure link to reset your password.";
}

<div class="space-y-6">
    <div>
        <h1 class="auth-h1">Forgot your password?</h1>
        <p class="auth-sub">Enter your email and we'll send you a reset link.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

    <form method="post" class="space-y-4">
        <div>
            <label asp-for="Input.Email" class="auth-label">Email</label>
            <input asp-for="Input.Email" class="auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="auth-error"></span>
        </div>

        <button type="submit" class="auth-btn">Reset Password</button>
    </form>

    <p class="text-center text-sm text-gray-400">
        <a asp-page="./Login" class="auth-link">Back to sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
