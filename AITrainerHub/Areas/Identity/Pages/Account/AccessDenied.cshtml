@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
    ViewData["AuthOverlay"] = "You don't have permission to view this page.";
}

<div class="space-y-6 text-center">
    <div class="mx-auto w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 grid place-items-center text-red-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
    </div>

    <div>
        <h1 class="auth-h1">Access denied</h1>
        <p class="auth-sub">You do not have access to this resource.</p>
    </div>

    <a asp-area="Users" asp-controller="Home" asp-action="Index" class="auth-btn">Back to home</a>
</div>
