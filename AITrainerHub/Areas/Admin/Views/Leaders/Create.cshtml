@model CreateLeaderViewModel
@{
    ViewData["Title"] = "Create Leader";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">Create leader</h2>
        <p class="admin-page-subtitle">Create an account for a new Leader. Public registration is disabled, so this is the only way to add accounts.</p>
    </div>

    <div class="admin-page-actions">
        <a asp-area="Admin" asp-controller="Leaders" asp-action="Index" class="admin-btn admin-btn--ghost">Back to leaders</a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card__header">
        <div>
            <h3 class="admin-card__title">Leader account</h3>
            <p class="admin-card__subtitle">The leader can change their password after signing in.</p>
        </div>
        <span class="admin-badge admin-badge--purple">Leader role</span>
    </div>

    <div class="admin-card__body">
        <form asp-area="Admin" asp-controller="Leaders" asp-action="Create" method="post" class="admin-form" data-submit-once>
            <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--error" role="alert"></div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="DisplayName" class="admin-label"></label>
                    <input asp-for="DisplayName" class="admin-input" maxlength="100" placeholder="e.g. Alex Morgan" autocomplete="name" />
                    <span asp-validation-for="DisplayName" class="admin-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="Email" class="admin-label"></label>
                    <input asp-for="Email" type="email" dir="ltr" class="admin-input" maxlength="200" placeholder="leader@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="admin-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="Password" class="admin-label"></label>
                    <input asp-for="Password" type="password" dir="ltr" class="admin-input" maxlength="100" autocomplete="new-password" />
                    <span class="admin-help">At least 8 characters with uppercase, lowercase, a number and a symbol.</span>
                    <span asp-validation-for="Password" class="admin-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="ConfirmPassword" class="admin-label"></label>
                    <input asp-for="ConfirmPassword" type="password" dir="ltr" class="admin-input" maxlength="100" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="admin-error"></span>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="admin-btn admin-btn--primary">Create leader account</button>
                <a asp-area="Admin" asp-controller="Leaders" asp-action="Index" class="admin-btn admin-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
