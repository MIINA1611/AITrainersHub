@model LeadersIndexViewModel
@{
    ViewData["Title"] = "Manage Leaders";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">Leaders</h2>
        <p class="admin-page-subtitle">Review leader accounts and activate or deactivate access to the platform.</p>
    </div>

    <div class="admin-page-actions">
        <a asp-area="Admin" asp-controller="Leaders" asp-action="Create" class="admin-btn admin-btn--primary">Create leader</a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card__header">
        <div>
            <h3 class="admin-card__title">Leader Accounts</h3>
            <p class="admin-card__subtitle">Deactivating a leader immediately blocks sign-in and invalidates their active session.</p>
        </div>
        <span class="admin-badge admin-badge--purple">@Model.Leaders.Count total</span>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table admin-table--xwide">
            <colgroup>
                <col style="width: 21%" />
                <col style="width: 24%" />
                <col style="width: 13%" />
                <col style="width: 10%" />
                <col style="width: 11%" />
                <col style="width: 21%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Registered</th>
                    <th>Ops #</th>
                    <th>Status</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leaders.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="admin-empty">No leader accounts found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var leader in Model.Leaders)
                    {
                        <tr>
                            <td>
                                <div class="admin-actions">
                                    <span class="admin-avatar">@(string.IsNullOrWhiteSpace(leader.DisplayName) ? "?" : leader.DisplayName.Substring(0, 1).ToUpperInvariant())</span>
                                    <span class="admin-cell-title">@leader.DisplayName</span>
                                </div>
                            </td>
                            <td><span class="admin-ltr">@leader.Email</span></td>
                            <td>@leader.RegisteredAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>@leader.OpportunitiesCount</td>
                            <td>
                                @if (leader.IsActive)
                                {
                                    <span class="admin-badge admin-badge--green">Active</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge--red">Inactive</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="cell-actions">
                                    <form asp-area="Admin" asp-controller="Leaders" asp-action="ToggleStatus" method="post" asp-antiforgery="true" data-confirm="@(leader.IsActive ? "Deactivate this leader? They will be signed out immediately." : "Activate this leader account?")">
                                        <input type="hidden" name="id" value="@leader.Id" />
                                        @if (leader.IsActive)
                                        {
                                            <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="admin-btn admin-btn--success admin-btn--sm">Activate</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
