@model PlatformFormRequest
@{
    ViewData["Title"] = "Add Platform";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">Add Platform</h2>
        <p class="admin-page-subtitle">Create the platform record first, then add categories, countries, and guides.</p>
    </div>

    <div class="admin-page-actions">
        <a asp-area="Admin" asp-controller="Platform" asp-action="Index" class="admin-btn admin-btn--ghost">Back to Platforms</a>
    </div>
</div>

<div class="admin-card" style="max-width: 60rem;">
    <div class="admin-card__body">
        <form asp-area="Admin" asp-controller="Platform" asp-action="Create" method="post" asp-antiforgery="true" class="admin-form" data-submit-once>
            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="Name" class="admin-label">Platform name</label>
                    <input asp-for="Name" class="admin-input" placeholder="e.g. Remotasks" autocomplete="off" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="Slug" class="admin-label">Slug</label>
                    <input asp-for="Slug" class="admin-input admin-ltr" placeholder="e.g. remotasks" autocomplete="off" />
                    <span class="admin-help">Lowercase letters, numbers, and hyphens only.</span>
                    <span asp-validation-for="Slug" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="WebsiteUrl" class="admin-label">Website URL</label>
                    <input asp-for="WebsiteUrl" class="admin-input admin-ltr" placeholder="https://example.com" autocomplete="off" />
                    <span asp-validation-for="WebsiteUrl" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="ReferralLink" class="admin-label">Referral link (optional)</label>
                    <input asp-for="ReferralLink" class="admin-input admin-ltr" placeholder="https://example.com/ref" autocomplete="off" />
                    <span asp-validation-for="ReferralLink" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-field" style="max-width: 16rem;">
                <label asp-for="Status" class="admin-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<PlatformStatus>()" class="admin-select"></select>
                <span asp-validation-for="Status" class="field-validation-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="DescriptionAr" class="admin-label">Arabic description</label>
                <textarea asp-for="DescriptionAr" class="admin-textarea" dir="rtl" placeholder="وصف المنصة بالعربية"></textarea>
                <span asp-validation-for="DescriptionAr" class="field-validation-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="DescriptionEn" class="admin-label">English description</label>
                <textarea asp-for="DescriptionEn" class="admin-textarea" dir="ltr" placeholder="Platform description in English"></textarea>
                <span asp-validation-for="DescriptionEn" class="field-validation-error"></span>
            </div>

            <div class="admin-actions">
                <button type="submit" class="admin-btn admin-btn--primary">Create Platform</button>
                <a asp-area="Admin" asp-controller="Platform" asp-action="Index" class="admin-btn admin-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
