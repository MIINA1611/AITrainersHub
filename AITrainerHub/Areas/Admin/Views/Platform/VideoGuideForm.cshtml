@model VideoGuideFormRequest
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Add Video Guide" : "Edit Video Guide";
    var platformName = ViewData["PlatformName"] as string ?? "Platform";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">@ViewData["Title"]</h2>
        <p class="admin-page-subtitle">@platformName · New guides stay pending until an administrator approves them.</p>
    </div>

    <div class="admin-page-actions">
        <a asp-area="Admin" asp-controller="Platform" asp-action="Edit" asp-route-id="@Model.PlatformId" class="admin-btn admin-btn--ghost">Back to Platform</a>
    </div>
</div>

<div class="admin-card" style="max-width: 60rem;">
    <div class="admin-card__body">
        <form asp-area="Admin" asp-controller="Platform" asp-action="SaveVideoGuide" method="post" asp-antiforgery="true" class="admin-form" data-submit-once>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PlatformId" />

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <div class="admin-field">
                <label asp-for="Title" class="admin-label">Video title</label>
                <input asp-for="Title" class="admin-input" autocomplete="off" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="Language" class="admin-label">Language</label>
                    <select asp-for="Language" asp-items="Html.GetEnumSelectList<GuideLanguage>()" class="admin-select"></select>
                    <span asp-validation-for="Language" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="SourceType" class="admin-label">Source type</label>
                    <input asp-for="SourceType" class="admin-input" placeholder="YouTube, Vimeo, Website…" autocomplete="off" />
                    <span asp-validation-for="SourceType" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-field">
                <label asp-for="Url" class="admin-label">Video URL</label>
                <input asp-for="Url" class="admin-input admin-ltr" placeholder="https://www.youtube.com/watch?v=…" autocomplete="off" />
                <span asp-validation-for="Url" class="field-validation-error"></span>
            </div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="AuthorOrChannel" class="admin-label">Author or channel (optional)</label>
                    <input asp-for="AuthorOrChannel" class="admin-input" autocomplete="off" />
                    <span asp-validation-for="AuthorOrChannel" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="PublishedAt" class="admin-label">Published date (optional)</label>
                    <input asp-for="PublishedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="admin-input" />
                    <span asp-validation-for="PublishedAt" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-actions">
                <button type="submit" class="admin-btn admin-btn--primary">Save Video Guide</button>
                <a asp-area="Admin" asp-controller="Platform" asp-action="Edit" asp-route-id="@Model.PlatformId" class="admin-btn admin-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
