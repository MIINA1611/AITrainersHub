@model OnboardingStepFormRequest
@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Add Onboarding Step" : "Edit Onboarding Step";
    var platformName = ViewData["PlatformName"] as string ?? "Platform";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">@ViewData["Title"]</h2>
        <p class="admin-page-subtitle">@platformName · Steps are displayed in ascending step-number order.</p>
    </div>

    <div class="admin-page-actions">
        <a asp-area="Admin" asp-controller="Platform" asp-action="Edit" asp-route-id="@Model.PlatformId" class="admin-btn admin-btn--ghost">Back to Platform</a>
    </div>
</div>

<div class="admin-card" style="max-width: 60rem;">
    <div class="admin-card__body">
        <form asp-area="Admin" asp-controller="Platform" asp-action="SaveOnboardingStep" method="post" asp-antiforgery="true" class="admin-form" data-submit-once>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PlatformId" />

            <div asp-validation-summary="All" class="validation-summary-errors"></div>

            <div class="admin-field" style="max-width: 12rem;">
                <label asp-for="StepNumber" class="admin-label">Step number</label>
                <input asp-for="StepNumber" type="number" min="1" max="999" class="admin-input" />
                <span asp-validation-for="StepNumber" class="field-validation-error"></span>
            </div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="TitleEn" class="admin-label">English title</label>
                    <input asp-for="TitleEn" class="admin-input" dir="ltr" autocomplete="off" />
                    <span asp-validation-for="TitleEn" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="TitleAr" class="admin-label">Arabic title</label>
                    <input asp-for="TitleAr" class="admin-input" dir="rtl" autocomplete="off" />
                    <span asp-validation-for="TitleAr" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-grid admin-grid--2">
                <div class="admin-field">
                    <label asp-for="DescriptionEn" class="admin-label">English description</label>
                    <textarea asp-for="DescriptionEn" class="admin-textarea" dir="ltr"></textarea>
                    <span asp-validation-for="DescriptionEn" class="field-validation-error"></span>
                </div>

                <div class="admin-field">
                    <label asp-for="DescriptionAr" class="admin-label">Arabic description</label>
                    <textarea asp-for="DescriptionAr" class="admin-textarea" dir="rtl"></textarea>
                    <span asp-validation-for="DescriptionAr" class="field-validation-error"></span>
                </div>
            </div>

            <div class="admin-field">
                <label asp-for="Tip" class="admin-label">Tip (optional)</label>
                <input asp-for="Tip" class="admin-input" autocomplete="off" />
                <span asp-validation-for="Tip" class="field-validation-error"></span>
            </div>

            <div class="admin-field">
                <label asp-for="ScreenshotUrl" class="admin-label">Screenshot URL (optional)</label>
                <input asp-for="ScreenshotUrl" class="admin-input admin-ltr" placeholder="https://example.com/step.png" autocomplete="off" />
                <span asp-validation-for="ScreenshotUrl" class="field-validation-error"></span>
            </div>

            <div class="admin-actions">
                <button type="submit" class="admin-btn admin-btn--primary">Save Step</button>
                <a asp-area="Admin" asp-controller="Platform" asp-action="Edit" asp-route-id="@Model.PlatformId" class="admin-btn admin-btn--ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
