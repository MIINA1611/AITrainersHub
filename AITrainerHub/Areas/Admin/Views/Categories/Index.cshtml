@model List<CategoryListResponse>
@{
    ViewData["Title"] = "Reference Data";
    ViewData["ReferenceTab"] = "categories";
}

<div class="admin-page-header">
    <div>
        <h2 class="admin-page-title">Reference Data</h2>
        <p class="admin-page-subtitle">Manage the categories, payment methods, and countries used across the platform catalog.</p>
    </div>
</div>

<partial name="_ReferenceDataTabs" />

<div class="admin-card">
    <div class="admin-card__header">
        <div>
            <h3 class="admin-card__title">Categories</h3>
            <p class="admin-card__subtitle">Categories group platforms and power catalog filtering.</p>
        </div>

        <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" asp-antiforgery="true" class="admin-inline-form">
            <input name="Name" class="admin-input admin-input--sm" placeholder="New category" maxlength="100" required autocomplete="off" />
            <input name="Description" class="admin-input admin-input--sm" placeholder="Description (optional)" maxlength="500" autocomplete="off" />
            <button type="submit" class="admin-btn admin-btn--primary admin-btn--sm">Add</button>
        </form>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <colgroup>
                <col style="width: 30%" />
                <col style="width: 45%" />
                <col style="width: 25%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="admin-empty">No categories yet. Use the form above to add the first one.</td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td><span class="admin-cell-title">@category.Name</span></td>
                            <td>@(string.IsNullOrWhiteSpace(category.Description) ? "—" : category.Description)</td>
                            <td class="col-actions">
                                <div class="cell-actions">
                                    <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="admin-btn admin-btn--ghost admin-btn--sm">Edit</a>
                                    <button type="button"
                                            class="admin-btn admin-btn--danger admin-btn--sm"
                                            data-delete-id="@category.Id"
                                            data-delete-name="@category.Name">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div id="deleteCategoryModal" class="fixed inset-0 z-50 grid place-items-center p-4 bg-black/70 hidden">
    <div class="bg-[#0a0a0a] border border-white/10 rounded-2xl p-6 max-w-md w-full" role="dialog" aria-modal="true" aria-labelledby="deleteCategoryTitle">
        <h3 id="deleteCategoryTitle" class="font-bold text-white">Delete category</h3>
        <p class="text-sm text-gray-400 mt-2">Are you sure you want to delete "<span id="deleteCategoryName"></span>"? This action cannot be undone.</p>
        <form id="deleteCategoryForm" asp-area="Admin" asp-controller="Categories" asp-action="Delete" method="post" asp-antiforgery="true" class="flex justify-end gap-2 mt-4">
            <input type="hidden" name="id" id="deleteCategoryId" />
            <button type="button" data-delete-cancel class="admin-btn admin-btn--ghost">Cancel</button>
            <button type="submit" class="admin-btn admin-btn--danger">Delete</button>
        </form>
    </div>
</div>
